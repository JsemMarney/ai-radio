# Port web UI (Next.js)
PORT=8787

# Icecast-like broadcaster port (API + engine, samostatny proces)
RADIO_STREAM_PORT=8788
RADIO_BROKER_URL=http://127.0.0.1:8788

# Icecast — distribuce streamu (engine → ffmpeg source → Icecast mount)
# ICECAST_ENABLED=1
# ICECAST_HOST=127.0.0.1
# ICECAST_PORT=8000
# ICECAST_MOUNT=/radio.mp3
# ICECAST_SOURCE_PASSWORD=hackme
# ICECAST_ADMIN_USER=admin
# ICECAST_ADMIN_PASSWORD=hackme
# ICECAST_LISTEN_URL=http://127.0.0.1:8000/radio.mp3
# ICECAST_BIN=

# Spotify API — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Studio heslo (chrání /studio a import API)
STUDIO_PASSWORD=change-me

# Branding stanice
STATION_NAME=Miss Radio
STATION_TAGLINE=24/7 auto DJ
STATION_LOGO_URL=/brand/logo.svg
STATION_COLOR_ACCENT=#d4a24c
STATION_COLOR_ACCENT_SOFT=#e8c57a
STATION_COLOR_BG=#0f1a14
STATION_COLOR_BG_MID=#16241c
STATION_COLOR_BG_PANEL=#1c2e24

# Radio přechody — equalpower (constant power) doporučeno pro rádio
RADIO_CROSSFADE_SEC=4
RADIO_CROSSFADE_CURVE=equalpower
RADIO_TRANSITION=crossfade
# Volitelné křivky: equalpower | linear | exp | log | qsin
# RADIO_DUCKING_DB=0

# Volitelné
# YTDLP_PATH=
# FFMPEG_PATH=

# Po kolika minutách bez mikrofonu posluchači místo jména moderátora vidí AutoDJ
# RADIO_MODERATOR_IDLE_MIN=30

# ── AI moderátor (mluví mezi písničkami naklonovaným hlasem) ──
# Text píše Claude (console.anthropic.com → API Keys)
# Text vstupů: Claude Haiku (má přednost), jinak NVIDIA (build.nvidia.com, zdarma, často přetížené).
NVIDIA_API_KEY=
# NVIDIA_MODEL=  (prázdné = zkouší víc modelů a pamatuje si, který funguje)
ANTHROPIC_API_KEY=
# Hlas: elevenlabs.io → Voices → Instant Voice Clone → ID hlasu; Profile → API key
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4  (výchozí, umí emoce; záloha eleven_v3, pak eleven_multilingual_v2)
# Jméno moderátora ve vstupech (jinak jméno ze studia)
# AI_DJ_NAME=
# Strop znaků hlasu za den (šetří kredit ElevenLabs)
# Měsíční rozpočet kreditů ElevenLabs (počítá se skutečná cena, ~0,4 kreditu/znak) — dělí se rovnoměrně na dny
# AI_DJ_MONTHLY_CHARS=10000
# Počasí pro město (výchozí Praha)
# RADIO_CITY=Praha
# RADIO_LAT=50.08
# RADIO_LON=14.42
