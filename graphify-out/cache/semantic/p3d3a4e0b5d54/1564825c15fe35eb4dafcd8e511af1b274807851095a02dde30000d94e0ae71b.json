{"nodes": [{"id": "readme_ai_radio", "label": "AI Radio", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Own internet radio: Spotify -> downloaded MP3 -> live HTTP stream with crossfade."}, {"id": "readme_spotify_api", "label": "Spotify API", "file_type": "concept", "source_file": "README.md", "source_location": "L10", "source_url": "https://developer.spotify.com/dashboard", "captured_at": null, "author": null, "contributor": null}, {"id": "readme_yt_dlp", "label": "yt-dlp", "file_type": "concept", "source_file": "README.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ffmpeg", "label": "ffmpeg", "file_type": "concept", "source_file": "README.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_studio", "label": "Studio (/studio)", "file_type": "concept", "source_file": "README.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_player", "label": "Player (/player)", "file_type": "concept", "source_file": "README.md", "source_location": "L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_radio_stream", "label": "Live Stream /api/radio/stream", "file_type": "concept", "source_file": "README.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_spotify_import", "label": "Spotify Import (POST /api/import)", "file_type": "concept", "source_file": "README.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Import track or playlist (max 50 songs); yt-dlp downloads, ffmpeg saves track.mp3 into downloads/{uuid}/."}, {"id": "readme_broadcaster", "label": "Broadcaster", "file_type": "rationale", "source_file": "README.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always running; per-track decoder, PCM mixer (crossfade, jingle, skip with fade) and a single persistent MP3 encoder so there are no gaps between tracks."}, {"id": "readme_crossfade", "label": "Crossfade Transition", "file_type": "rationale", "source_file": "README.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configurable via RADIO_CROSSFADE_SEC, RADIO_CROSSFADE_CURVE (equalpower recommended), RADIO_TRANSITION."}, {"id": "readme_rotation", "label": "Rotation Algorithm", "file_type": "rationale", "source_file": "README.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No repeat until ~60% of library played, same artist spaced by 3 others, remainder weighted lottery favoring long-unplayed tracks."}, {"id": "readme_smart_mix", "label": "Smart Mix (LUFS analysis)", "file_type": "rationale", "source_file": "README.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each track measured once for LUFS loudness, start and ending shape; normalized to station target and transitions adapted (fading endings blend earlier, hard endings play out, quiet intros come in under previous ending)."}, {"id": "readme_burst_buffer", "label": "Burst Buffer for New Listeners", "file_type": "rationale", "source_file": "README.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New listener gets a few seconds of buffer so playback starts immediately."}, {"id": "readme_aac_stream", "label": "AAC Stream (?format=aac)", "file_type": "concept", "source_file": "README.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bandwidth-saving secondary stream chosen on mobile or via quality toggle."}, {"id": "readme_fallback_jingle", "label": "Fallback Jingle (public/jingle.mp3)", "file_type": "concept", "source_file": "README.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Played instead of silence when nothing is queued."}, {"id": "readme_listener_requests", "label": "Listener Requests", "file_type": "concept", "source_file": "README.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requests with sender and message (max 200 chars, no links, profanity masked); moderator approves or rejects; expire after 30 min; rate-limited per IP."}, {"id": "readme_microphone", "label": "Live Microphone (WebSocket /mic)", "file_type": "concept", "source_file": "README.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voice sent via WebSocket to broadcaster and mixed into stream with automatic music ducking (-8/-14/-20 dB/full) returning after ~1s silence."}, {"id": "readme_security", "label": "Studio Security", "file_type": "rationale", "source_file": "README.md", "source_location": "L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "STUDIO_PASSWORD min 12 chars (studio locked in production otherwise), 7-day sessions, logout invalidates token, login rate limits, Origin check, CSP and security headers."}, {"id": "readme_icecast", "label": "Icecast", "file_type": "concept", "source_file": "README.md", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "config/icecast.xml generated from config/icecast.example.xml and .env.local passwords; not committed; refuses to start with weak passwords."}, {"id": "readme_env_config", "label": "Environment Variables (.env.local)", "file_type": "concept", "source_file": "README.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_trust_proxy", "label": "TRUST_PROXY / Reverse Proxy", "file_type": "concept", "source_file": "README.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only trust X-Forwarded-For behind own reverse proxy (nginx/Caddy)."}, {"id": "readme_public_deployment", "label": "Public Deployment", "file_type": "concept", "source_file": "README.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VPS/Railway/Fly.io, persistent disk for downloads/, HTTPS required for browser autoplay."}, {"id": "readme_downloads_dir", "label": "downloads/ directory", "file_type": "concept", "source_file": "README.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_api", "label": "Radio HTTP API", "file_type": "concept", "source_file": "README.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_ai_radio", "target": "readme_spotify_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L10", "weight": 1.0}, {"source": "readme_spotify_import", "target": "readme_spotify_api", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L33", "weight": 1.0}, {"source": "readme_spotify_import", "target": "readme_yt_dlp", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L34", "weight": 1.0}, {"source": "readme_spotify_import", "target": "readme_ffmpeg", "relation": "calls", "