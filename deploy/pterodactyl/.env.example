# Miss Radio — nastavení serveru.
# Přejmenuj na .env.local (nebo nastav stejné proměnné v panelu) a doplň hodnoty.

# ── Povinné ──────────────────────────────────────────────
# Heslo do studia: min. 12 znaků, jinak je studio v produkci zamčené.
STUDIO_PASSWORD=
# Dlouhé náhodné řetězce (např. 64 znaků) — podpis přihlášení a interní API.
SESSION_SECRET=
BROKER_SECRET=

# Spotify API (import skladeb) — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Stanice ──────────────────────────────────────────────
STATION_NAME=Miss Radio
STATION_TAGLINE=24/7 music
STATION_LOGO_URL=/brand/logo.svg
STATION_COLOR_ACCENT=#e5322d
STATION_COLOR_ACCENT_SOFT=#ff6b55
STATION_COLOR_BG=#120b0a
STATION_COLOR_BG_MID=#1b1110
STATION_COLOR_BG_PANEL=#241614

# ── Vysílání ─────────────────────────────────────────────
RADIO_STREAM_BITRATE=256
RADIO_AAC=1
RADIO_AAC_BITRATE=96
RADIO_CROSSFADE_SEC=6
RADIO_TARGET_LUFS=-16
RADIO_ARTIST_SPACING=3
RADIO_REQUESTS=1
RADIO_REQUESTS_MODERATION=1
RADIO_REQUESTS_PER_IP=2
RADIO_MIDSONG_PATH=public/MIDSONGS-1.wav
RADIO_MIDSONG_MIN_TRACKS=3
RADIO_MIDSONG_MAX_TRACKS=6

# Za reverse proxy / Cloudflare (HTTPS doména) nastav 1, jinak nech 0.
TRUST_PROXY=0

# Icecast na Pterodactylu neběží — nech vypnuté.
ICECAST_ENABLED=0
